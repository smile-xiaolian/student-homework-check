# Copy to .env before running docker compose.
POSTGRES_DB=edu_submission
POSTGRES_USER=edu_app
POSTGRES_PASSWORD=change-me-postgres

# Must be at least 32 characters. Replace in every shared environment.
JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters
JWT_REFRESH_COOKIE_SECURE=false

MINIO_ROOT_USER=edu_minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=edu-submission

APP_CORS_ORIGINS=http://localhost:5173,http://localhost:8088
APP_DEMO_DATA=true
UPLOAD_MAX_FILE_SIZE=100MB
UPLOAD_MAX_REQUEST_SIZE=110MB

# Originality-check worker
CHECK_POLL_SECONDS=2
CHECK_LEASE_SECONDS=120
CHECK_LOG_LEVEL=INFO

